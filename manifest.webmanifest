{
  "name": "Agro Express Pasto",
  "short_name": "AE Pasto",
  "description": "Levantamento de pastagem e proposta técnica e comercial.",
  "lang": "pt-BR",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#14532D",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./compartilhar",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "arquivos",
          "accept": [
            "application/vnd.google-earth.kml+xml",
            "application/vnd.google-earth.kmz",
            ".kml",
            ".kmz",
            "application/xml",
            "text/xml",
            "text/plain",
            "application/zip",
            "application/octet-stream"
          ]
        }
      ]
    }
  }
}
